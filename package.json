{
  "name": "sap_template",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@sap/cds": "^9",
    "@sap/cds-dk": "^9.6.0",
    "@sap/xssec": "^4.12.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.15.0",
    "@cap-js/openapi": "^1.3.0",
    "@cap-js/sqlite": "^2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "cds-swagger-ui-express": "^0.10.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4",
    "typescript": "^5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "deploy": "cds deploy --to sqlite:generalactivity.db"
  },
  "private": true,
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "impl": "@cap-js/sqlite",
        "credentials": {
          "database": "generalactivity.db",
          "url": "generalactivity.db"
        },
        "assertIntegrityType": "DB"
      }
    }
  }
}
